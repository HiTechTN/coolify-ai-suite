# Coolify AI Suite - Configuration
# Version: 3.0
# Copiez ce fichier en .env et adaptez selon vos besoins

# ============================================
# DOMAINE (optionnel - laisser vide pour .local)
# ============================================
DOMAIN=hitech.tn
SSL_EMAIL=admin@hitech.tn

# ============================================
# PORTS
# ============================================
TRAEFIK_HTTP_PORT=80
TRAEFIK_HTTPS_PORT=443
OLLAMA_PORT=11434
CODE_SERVER_PORT=8443
OPEN_WEBUI_PORT=3000
COOLIFY_PORT=8000

# ============================================
# MOTS DE PASSE (générer avec: openssl rand -base64 24)
# ============================================
CODE_SERVER_PASSWORD=
WEBUI_SECRET=

# ============================================
# SURVEILLANCE IP PUBLIQUE (optionnel)
# ============================================
# FIXED_IP - IP fixe du serveur (laissez vide pour détection auto)
# DNS_SERVERS - Serveurs DNS pour la résolution (laissez vide = DNS système)
FIXED_IP=
DNS_SERVERS=

# ============================================
# BACKUP
# ============================================
BACKUP_DIR=/opt/backups/ai-suite
RETENTION_DAYS=7

# ============================================
# RÉSEAU
# ============================================
NETWORK_NAME=ai-suite
AI_SUITE_DIR=/opt/ai-suite

# ============================================
# DDNS — MISE À JOUR DYNAMIQUE DNS (optionnel)
# ============================================
# Utilisé quand l'IP publique change (pas d'IP fixe).
# Nécessite un compte Cloudflare gratuit + token API (Zone.DNS:Edit).
# DDNS_ENABLED=true
# DDNS_PROVIDER=cloudflare
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ZONE_ID=

# ============================================
# FUSEAU HORAIRE
# ============================================
TZ=Africa/Tunis
